<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Proteger archivos y directorios sensibles del sistema
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package\.(json|lock)|phpunit\.xml|artisan) - [F,L,NC]

    # 2. Redirigir transparentemente todas las peticiones al directorio /public
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
